# Copy outside the repository or to an ignored env file; fill secrets locally.
APP_DOMAIN=food.example.com
TLS_CONTACT_EMAIL=operations@example.com
PUBLIC_APP_URL=https://food.example.com
EMAIL_ALLOWED_ORIGINS=https://food.example.com
# Use immutable reviewed image digests; migration image must match the release.
BACKEND_IMAGE=
FRONTEND_IMAGE=
MIGRATION_IMAGE=
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
SECURITY_NAMESPACE=rec-food-staging
WORKER_ENABLED=true
# Copy required backend/.env.example provider/email/budget fields into the private env.
# Keep blanks for providers not configured. Never use development keys in staging.
