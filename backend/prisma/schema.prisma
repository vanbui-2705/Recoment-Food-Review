generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum AllergySeverity {
  UNKNOWN
  MILD
  MODERATE
  SEVERE

  @@map("allergy_severity")
}

enum VerificationStatus {
  UNVERIFIED
  REVIEWED
  VERIFIED

  @@map("verification_status")
}

enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN

  @@map("allergen_presence")
}

enum DishPreferenceValue {
  LIKED
  DISLIKED

  @@map("dish_preference_value")
}

enum RestaurantBusinessStatus {
  UNKNOWN
  OPERATIONAL
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED

  @@map("restaurant_business_status")
}

enum RecommendationStatus {
  SUCCESS
  NO_MATCH
  NO_SAFE_MATCH
  INSUFFICIENT_DATA
  FAILED

  @@map("recommendation_status")
}

enum MealPeriod {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  LATE_NIGHT

  @@map("meal_period")
}

enum UserInteractionType {
  VIEWED
  LIKED
  SKIPPED
  CHOSEN
  EATEN
  RATED

  @@map("user_interaction_type")
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique @db.VarChar(255)
  passwordHash           String                   @map("password_hash")
  displayName            String                   @map("display_name") @db.VarChar(100)
  role                   UserRole                 @default(USER)
  status                 UserStatus               @default(ACTIVE)
  authVersion            Int                      @default(0) @map("auth_version")
  legacyAccessDisabled   Boolean                  @default(false) @map("legacy_access_disabled")
  emailVerifiedAt        DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens          RefreshToken[]
  tasteProfile           TasteProfile?
  allergies              UserAllergy[]
  dietaryRestrictions    UserDietaryRestriction[]
  cuisinePreferences     UserCuisinePreference[]
  dishPreferences        UserDishPreference[]
  recommendationRequests RecommendationRequest[]
  interactions           UserInteraction[]
  recipeInteractions     RecipeInteraction[]
  foodKnowledge          PersonalFoodKnowledge?
  tasteAnalysisJobs      TasteAnalysisJob[]
  discoverySettings      DiscoverySettings?
  conversations          Conversation[]
  dataReports            DataReport[]
  emailActionTokens      EmailActionToken[]
  deletionJob            AccountDeletionJob?

  @@map("users")
}

model EmailActionToken {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  purpose     String       @db.VarChar(10)
  tokenHash   String       @unique @map("token_hash") @db.VarChar(64)
  authVersion Int          @map("auth_version")
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox      EmailOutbox?

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_action_tokens")
}

model EmailOutbox {
  id                String           @id @default(uuid()) @db.Uuid
  tokenId           String           @unique @map("token_id") @db.Uuid
  encryptedBody     String?          @map("encrypted_body")
  status            String           @default("QUEUED") @db.VarChar(12)
  attempts          Int              @default(0)
  availableAt       DateTime         @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken        String?          @map("lease_token") @db.Uuid
  leaseUntil        DateTime?        @map("lease_until") @db.Timestamptz(3)
  providerMessageId String?          @map("provider_message_id") @db.VarChar(100)
  errorCode         String?          @map("error_code") @db.VarChar(50)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  token             EmailActionToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, leaseUntil])
  @@map("email_outbox")
}

model MaintenanceLease {
  name            String    @id @db.VarChar(80)
  leaseToken      String?   @map("lease_token") @db.Uuid
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(3)
  nextRunAt       DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lastCompletedAt DateTime? @map("last_completed_at") @db.Timestamptz(3)
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(50)

  @@map("maintenance_leases")
}

model AccountDeletionJob {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  status      String    @default("QUEUED") @db.VarChar(10)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken  String?   @map("lease_token") @db.Uuid
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(3)
  errorCode   String?   @map("error_code") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, leaseUntil])
  @@map("account_deletion_jobs")
}

model AiRequestCounter {
  namespace String @db.VarChar(64)
  day       String @db.VarChar(10)
  requests  Int    @default(0)

  @@id([namespace, day])
  @@map("ai_request_counters")
}

model AiBudgetUsage {
  namespace      String @db.VarChar(64)
  day            String @db.VarChar(10)
  reservedMicros BigInt @default(0) @map("reserved_micros")
  requests       Int    @default(0)

  @@id([namespace, day])
  @@map("ai_budget_usage")
}

model SharedQuotaBucket {
  key       String   @id @db.VarChar(64)
  namespace String   @db.VarChar(64)
  scope     String   @db.VarChar(80)
  count     Int
  resetAt   DateTime @map("reset_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resetAt], map: "shared_quota_buckets_expiry_idx")
  @@index([namespace, scope, resetAt], map: "shared_quota_buckets_scope_idx")
  @@map("shared_quota_buckets")
}

model ProviderObservation {
  namespace       String    @db.VarChar(64)
  provider        String    @db.VarChar(20)
  lastAttemptAt   DateTime  @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt   DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastStatus      String    @map("last_status") @db.VarChar(20)
  requests        BigInt    @default(0)
  failures        BigInt    @default(0)
  quotaRejections BigInt    @default(0) @map("quota_rejections")

  @@id([namespace, provider])
  @@map("provider_observations")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String        @db.VarChar(100)
  context   Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  runs      ChatRun[]

  @@index([userId, updatedAt(sort: Desc), id])
  @@index([updatedAt, id], map: "conversations_retention_idx")
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String       @db.VarChar(10)
  content        String       @db.VarChar(4000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            ChatRun?

  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}

model ChatRun {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  messageId      String       @unique @map("message_id") @db.Uuid
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(255)
  inputHash      String       @map("input_hash") @db.VarChar(64)
  context        Json
  status         String       @default("QUEUED") @db.VarChar(12)
  attempts       Int          @default(0)
  leaseToken     String?      @map("lease_token") @db.Uuid
  leaseUntil     DateTime?    @map("lease_until") @db.Timestamptz(3)
  nextSeq        Int          @default(0) @map("next_seq")
  errorCode      String?      @map("error_code") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  events         ChatEvent[]

  @@index([status, leaseUntil, createdAt])
  @@index([conversationId, createdAt])
  @@map("chat_runs")
}

model ChatEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  type      String   @db.VarChar(20)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run       ChatRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("chat_events")
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  familyId          String        @map("family_id") @db.Uuid
  authVersion       Int           @default(0) @map("auth_version")
  tokenHash         String        @unique @map("token_hash")
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?       @unique @map("replaced_by_token_id") @db.Uuid
  lastUsedAt        DateTime?     @map("last_used_at") @db.Timestamptz(3)
  userAgent         String?       @map("user_agent")
  ipAddress         String?       @map("ip_address") @db.Inet
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken? @relation("TokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken? @relation("TokenReplacement")

  @@index([userId, expiresAt])
  @@index([userId, familyId, revokedAt])
  @@map("refresh_tokens")
}

model TasteProfile {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @unique @map("user_id") @db.Uuid
  spicyLevel          Int         @map("spicy_level") @db.SmallInt
  sweetLevel          Int         @map("sweet_level") @db.SmallInt
  sourLevel           Int         @map("sour_level") @db.SmallInt
  saltyLevel          Int         @map("salty_level") @db.SmallInt
  budgetMin           Int         @map("budget_min")
  budgetMax           Int         @map("budget_max")
  maxDistanceMeters   Int         @map("max_distance_meters")
  latitude            Float?      @db.DoublePrecision
  longitude           Float?      @db.DoublePrecision
  areaLabel           String?     @map("area_label") @db.VarChar(200)
  mealPeriod          MealPeriod? @map("meal_period")
  onboardingCompleted Boolean     @default(false) @map("onboarding_completed")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("taste_profiles")
}

model DiscoverySettings {
  userId    String   @id @map("user_id") @db.Uuid
  budget    Int      @default(50000)
  radius    Int      @default(3500)
  latitude  Float?   @db.DoublePrecision
  longitude Float?   @db.DoublePrecision
  onlyOpen  Boolean  @default(false) @map("only_open")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discovery_settings")
}

model Allergen {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(50)
  name        String         @db.VarChar(100)
  description String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  users       UserAllergy[]
  dishes      DishAllergen[]

  @@map("allergens")
}

model UserAllergy {
  userId     String          @map("user_id") @db.Uuid
  allergenId String          @map("allergen_id") @db.Uuid
  severity   AllergySeverity @default(UNKNOWN)
  notes      String?         @db.VarChar(500)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen   Allergen        @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([userId, allergenId])
  @@map("user_allergies")
}

model DietaryRestriction {
  id          String                   @id @default(uuid()) @db.Uuid
  code        String                   @unique @db.VarChar(50)
  name        String                   @db.VarChar(100)
  description String?
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  users       UserDietaryRestriction[]

  @@map("dietary_restrictions")
}

model UserDietaryRestriction {
  userId               String             @map("user_id") @db.Uuid
  dietaryRestrictionId String             @map("dietary_restriction_id") @db.Uuid
  isMandatory          Boolean            @default(true) @map("is_mandatory")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryRestriction   DietaryRestriction @relation(fields: [dietaryRestrictionId], references: [id], onDelete: Restrict)

  @@id([userId, dietaryRestrictionId])
  @@map("user_dietary_restrictions")
}

model Cuisine {
  isActive    Boolean                 @default(true) @map("is_active")
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  id          String                  @id @default(uuid()) @db.Uuid
  code        String                  @unique @db.VarChar(50)
  name        String                  @db.VarChar(100)
  description String?
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  users       UserCuisinePreference[]
  dishes      Dish[]

  @@map("cuisines")
}

model UserCuisinePreference {
  userId          String   @map("user_id") @db.Uuid
  cuisineId       String   @map("cuisine_id") @db.Uuid
  preferenceScore Int      @map("preference_score") @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuisine         Cuisine  @relation(fields: [cuisineId], references: [id], onDelete: Restrict)

  @@id([userId, cuisineId])
  @@map("user_cuisine_preferences")
}

model Dish {
  isActive              Boolean                @default(true) @map("is_active")
  id                    String                 @id @default(uuid()) @db.Uuid
  slug                  String                 @unique @db.VarChar(120)
  name                  String                 @db.VarChar(150)
  description           String?
  cuisineId             String                 @map("cuisine_id") @db.Uuid
  priceMin              Int                    @map("price_min")
  priceMax              Int                    @map("price_max")
  spicyLevel            Int                    @map("spicy_level") @db.SmallInt
  sweetLevel            Int                    @map("sweet_level") @db.SmallInt
  sourLevel             Int                    @map("sour_level") @db.SmallInt
  saltyLevel            Int                    @map("salty_level") @db.SmallInt
  evidenceSource        String?                @map("evidence_source") @db.VarChar(500)
  dietaryCodes          String[]               @default([]) @map("dietary_codes")
  mealPeriods           MealPeriod[]           @default([]) @map("meal_periods")
  verificationStatus    VerificationStatus     @default(UNVERIFIED) @map("verification_status")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  cuisine               Cuisine                @relation(fields: [cuisineId], references: [id], onDelete: Restrict)
  aliases               DishAlias[]
  ingredients           DishIngredient[]
  allergens             DishAllergen[]
  userPreferences       UserDishPreference[]
  restaurants           RestaurantDish[]
  recommendationResults RecommendationResult[]
  interactions          UserInteraction[]
  externalOffers        ExternalMenuItem[]
  recipeInteractions    RecipeInteraction[]

  @@index([cuisineId])
  @@index([isActive, id], map: "dishes_moderation_idx")
  @@map("dishes")
}

model DishAlias {
  id              String   @id @default(uuid()) @db.Uuid
  dishId          String   @map("dish_id") @db.Uuid
  alias           String   @db.VarChar(150)
  normalizedAlias String   @map("normalized_alias") @db.VarChar(150)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dish            Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("dish_aliases")
}

model Ingredient {
  isActive    Boolean          @default(true) @map("is_active")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(150)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  dishes      DishIngredient[]

  @@map("ingredients")
}

model DishIngredient {
  dishId       String     @map("dish_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  isPrimary    Boolean    @default(false) @map("is_primary")
  notes        String?    @db.VarChar(300)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([dishId, ingredientId])
  @@index([ingredientId])
  @@map("dish_ingredients")
}

model DishAllergen {
  dishId             String             @map("dish_id") @db.Uuid
  allergenId         String             @map("allergen_id") @db.Uuid
  presence           AllergenPresence
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  evidenceSource     String             @map("evidence_source") @db.VarChar(500)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  dish               Dish               @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen           Allergen           @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([dishId, allergenId])
  @@index([allergenId])
  @@map("dish_allergens")
}

model UserDishPreference {
  userId     String              @map("user_id") @db.Uuid
  dishId     String              @map("dish_id") @db.Uuid
  preference DishPreferenceValue
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish       Dish                @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([userId, dishId])
  @@index([dishId])
  @@map("user_dish_preferences")
}

model Restaurant {
  isActive              Boolean                      @default(true) @map("is_active")
  id                    String                       @id @default(uuid()) @db.Uuid
  googlePlaceId         String?                      @unique @map("google_place_id") @db.VarChar(255)
  name                  String                       @db.VarChar(200)
  address               String                       @db.VarChar(500)
  latitude              Decimal                      @db.Decimal(9, 6)
  longitude             Decimal                      @db.Decimal(9, 6)
  rating                Decimal?                     @db.Decimal(2, 1)
  ratingCount           Int                          @default(0) @map("rating_count")
  priceLevel            Int?                         @map("price_level") @db.SmallInt
  businessStatus        RestaurantBusinessStatus     @default(UNKNOWN) @map("business_status")
  placesDataUpdatedAt   DateTime?                    @map("places_data_updated_at") @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  dishes                RestaurantDish[]
  recommendationResults RecommendationResult[]
  interactions          UserInteraction[]
  externalIdentities    ExternalRestaurantIdentity[]

  @@index([latitude, longitude])
  @@index([isActive, id], map: "restaurants_moderation_idx")
  @@map("restaurants")
}

model RestaurantDish {
  restaurantId String     @map("restaurant_id") @db.Uuid
  dishId       String     @map("dish_id") @db.Uuid
  price        Int
  isAvailable  Boolean    @default(true) @map("is_available")
  source       String     @db.VarChar(500)
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([restaurantId, dishId])
  @@index([dishId])
  @@map("restaurant_dishes")
}

model RecommendationRequest {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @map("user_id") @db.Uuid
  requestedAt            DateTime               @default(now()) @map("requested_at") @db.Timestamptz(3)
  latitude               Decimal                @db.Decimal(9, 6)
  longitude              Decimal                @db.Decimal(9, 6)
  mealPeriod             MealPeriod?            @map("meal_period")
  weather                String?                @db.VarChar(100)
  budgetMin              Int?                   @map("budget_min")
  budgetMax              Int?                   @map("budget_max")
  maxDistanceMeters      Int?                   @map("max_distance_meters")
  naturalLanguageRequest String?                @map("natural_language_request") @db.VarChar(1000)
  status                 RecommendationStatus
  idempotencyKey         String?                @unique @map("idempotency_key") @db.VarChar(255)
  inputHash              String?                @map("input_hash") @db.VarChar(64)
  profileRevision        Int?                   @map("profile_revision")
  processingState        String                 @default("COMPLETED") @map("processing_state") @db.VarChar(30)
  leaseUntil             DateTime?              @map("lease_until") @db.Timestamptz(3)
  leaseToken             String?                @map("lease_token") @db.Uuid
  rankingStatus          String                 @default("DETERMINISTIC") @map("ranking_status") @db.VarChar(80)
  outcomeCode            String?                @map("outcome_code") @db.VarChar(80)
  onlyOpen               Boolean                @default(false) @map("only_open")
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  results                RecommendationResult[]

  @@index([userId, requestedAt(sort: Desc)])
  @@index([processingState, leaseUntil])
  @@index([requestedAt, id], map: "recommendation_requests_retention_idx")
  @@map("recommendation_requests")
}

model RecommendationResult {
  id             String                @id @default(uuid()) @db.Uuid
  requestId      String                @map("request_id") @db.Uuid
  dishId         String                @map("dish_id") @db.Uuid
  restaurantId   String?               @map("restaurant_id") @db.Uuid
  rank           Int
  baseScore      Decimal               @map("base_score") @db.Decimal(7, 4)
  finalScore     Decimal               @map("final_score") @db.Decimal(7, 4)
  reason         String                @db.VarChar(1000)
  safetyWarnings Json                  @map("safety_warnings") @db.JsonB
  offerId        String?               @map("offer_id") @db.Uuid
  price          Int?
  expiresAt      DateTime?             @map("expires_at") @db.Timestamptz(3)
  offer          ExternalMenuItem?     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  request        RecommendationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dish           Dish                  @relation(fields: [dishId], references: [id], onDelete: Restrict)
  restaurant     Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  interactions   UserInteraction[]

  @@unique([requestId, rank])
  @@unique([requestId, offerId])
  @@index([dishId])
  @@index([restaurantId])
  @@map("recommendation_results")
}

model UserInteraction {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  recommendationResultId String?               @map("recommendation_result_id") @db.Uuid
  dishId                 String                @map("dish_id") @db.Uuid
  restaurantId           String?               @map("restaurant_id") @db.Uuid
  interactionType        UserInteractionType   @map("interaction_type")
  rating                 Int?                  @db.SmallInt
  feedbackOfId           String?               @map("feedback_of_id") @db.Uuid
  feedbackOf             UserInteraction?      @relation("DishHistoryFeedback", fields: [feedbackOfId], references: [id], onDelete: Cascade)
  feedback               UserInteraction[]     @relation("DishHistoryFeedback")
  idempotencyKey         String                @unique @map("idempotency_key") @db.VarChar(255)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationResult   RecommendationResult? @relation(fields: [recommendationResultId], references: [id], onDelete: SetNull)
  dish                   Dish                  @relation(fields: [dishId], references: [id], onDelete: Restrict)
  restaurant             Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt, id], map: "user_interactions_retention_idx")
  @@index([recommendationResultId])
  @@index([feedbackOfId, createdAt(sort: Desc)])
  @@index([dishId])
  @@index([restaurantId])
  @@map("user_interactions")
}

// Store only the reference and title for user history, not provider recipe content.
model RecipeInteraction {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  source          String              @db.VarChar(30)
  recipeId        String              @map("recipe_id") @db.VarChar(30)
  title           String              @db.VarChar(200)
  canonicalName   String              @map("canonical_name") @db.VarChar(200)
  canonicalDishId String?             @map("canonical_dish_id") @db.Uuid
  canonicalDish   Dish?               @relation(fields: [canonicalDishId], references: [id], onDelete: Restrict)
  rating          Int?                @db.SmallInt
  feedbackOfId    String?             @map("feedback_of_id") @db.Uuid
  feedbackOf      RecipeInteraction?  @relation("RecipeHistoryFeedback", fields: [feedbackOfId], references: [id], onDelete: Cascade)
  feedback        RecipeInteraction[] @relation("RecipeHistoryFeedback")
  interactionType UserInteractionType @map("interaction_type")
  idempotencyKey  String              @unique @map("idempotency_key") @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt, id], map: "recipe_interactions_retention_idx")
  @@index([userId, canonicalName])
  @@index([canonicalDishId])
  @@index([feedbackOfId, createdAt(sort: Desc)])
  @@map("recipe_interactions")
}

// A future extractor must process the exact revision of this user-owned text.
model PersonalFoodKnowledge {
  userId           String   @id @map("user_id") @db.Uuid
  description      String   @db.VarChar(6000)
  revision         Int      @default(1)
  analyzedRevision Int      @default(0) @map("analyzed_revision")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_food_knowledge")
}

enum TasteAnalysisStatus {
  QUEUED
  RUNNING
  NEEDS_REVIEW
  APPLIED
  FAILED
  SUPERSEDED

  @@map("taste_analysis_status")
}

model TasteAnalysisJob {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  sourceRevision Int                 @map("source_revision")
  schemaVersion  Int                 @default(1) @map("schema_version")
  status         TasteAnalysisStatus @default(QUEUED)
  attempt        Int                 @default(0)
  availableAt    DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil     DateTime?           @map("lease_until") @db.Timestamptz(3)
  leaseToken     String?             @map("lease_token") @db.Uuid
  result         Json?
  model          String?             @db.VarChar(100)
  errorCode      String?             @map("error_code") @db.VarChar(80)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRevision, schemaVersion])
  @@index([status, availableAt, leaseUntil])
  @@index([createdAt, id], map: "taste_analysis_jobs_retention_idx")
  @@map("taste_analysis_jobs")
}

model AiRequestUsage {
  day      String @id @db.VarChar(10)
  requests Int    @default(0)

  @@map("ai_request_usage")
}

enum MenuSyncMode {
  COMPLETE
  DELTA
}

enum MenuSyncStatus {
  STAGING
  COMMITTED
  FAILED
}

enum OfferMappingStatus {
  PENDING
  APPROVED
}

enum SafetyEvidenceKind {
  ALLERGEN
  DIET
  CROSS_CONTACT
}

enum SafetyEvidenceClaim {
  PRESENT
  ABSENT
  UNKNOWN
}

enum SafetyEvidenceStatus {
  PENDING
  APPROVED
  REVOKED
}

model MerchantSupplier {
  id                     String                       @id @default(uuid()) @db.Uuid
  code                   String                       @unique @db.VarChar(80)
  name                   String                       @db.VarChar(200)
  documentationUrl       String                       @map("documentation_url") @db.VarChar(2000)
  authorizationReference String                       @map("authorization_reference") @db.VarChar(500)
  maxEvidenceAgeHours    Int                          @default(24) @map("max_evidence_age_hours")
  enabled                Boolean                      @default(false)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastCommittedAt        DateTime?                    @map("last_committed_at") @db.Timestamptz(3)
  identities             ExternalRestaurantIdentity[]
  syncRuns               MenuSyncRun[]
  syncSchedule           MenuSyncSchedule?

  @@map("merchant_suppliers")
}

model ExternalRestaurantIdentity {
  id           String             @id @default(uuid()) @db.Uuid
  supplierId   String             @map("supplier_id") @db.Uuid
  externalId   String             @map("external_id") @db.VarChar(255)
  restaurantId String             @map("restaurant_id") @db.Uuid
  supplier     MerchantSupplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  offers       ExternalMenuItem[]

  @@unique([supplierId, externalId])
  @@index([restaurantId])
  @@map("external_restaurant_identities")
}

model ExternalMenuItem {
  moderationEnabled     Boolean                    @default(true) @map("moderation_enabled")
  id                    String                     @id @default(uuid()) @db.Uuid
  identityId            String                     @map("identity_id") @db.Uuid
  externalId            String                     @map("external_id") @db.VarChar(255)
  title                 String                     @db.VarChar(200)
  optionLabel           String?                    @map("option_label") @db.VarChar(200)
  price                 Int
  currency              String                     @default("VND") @db.VarChar(3)
  isAvailable           Boolean                    @default(true) @map("is_available")
  active                Boolean                    @default(true)
  sourceUrl             String                     @map("source_url") @db.VarChar(2000)
  observedAt            DateTime                   @map("observed_at") @db.Timestamptz(3)
  expiresAt             DateTime                   @map("expires_at") @db.Timestamptz(3)
  dishId                String?                    @map("dish_id") @db.Uuid
  mappingStatus         OfferMappingStatus         @default(PENDING) @map("mapping_status")
  lastSyncRunId         String                     @map("last_sync_run_id") @db.Uuid
  lastSyncRun           MenuSyncRun                @relation(fields: [lastSyncRunId], references: [id], onDelete: Restrict)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  identity              ExternalRestaurantIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  dish                  Dish?                      @relation(fields: [dishId], references: [id], onDelete: Restrict)
  evidence              OfferSafetyEvidence[]
  recommendationResults RecommendationResult[]

  @@unique([identityId, externalId])
  @@index([active, isAvailable, expiresAt])
  @@index([dishId])
  @@index([moderationEnabled, id], map: "external_menu_items_moderation_idx")
  @@map("external_menu_items")
}

model MenuSyncRun {
  id            String             @id @default(uuid()) @db.Uuid
  supplierId    String             @map("supplier_id") @db.Uuid
  snapshotId    String             @map("snapshot_id") @db.VarChar(255)
  mode          MenuSyncMode
  status        MenuSyncStatus     @default(STAGING)
  expectedPages Int                @map("expected_pages")
  observedAt    DateTime           @map("observed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt   DateTime?          @map("committed_at") @db.Timestamptz(3)
  errorCode     String?            @map("error_code") @db.VarChar(80)
  supplier      MerchantSupplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  workerJobs    MenuSyncJob[]
  pages         MenuSyncPage[]
  quarantine    MenuQuarantine[]
  offers        ExternalMenuItem[]

  @@unique([supplierId, snapshotId])
  @@index([supplierId, status, createdAt])
  @@map("menu_sync_runs")
}

model MenuSyncPage {
  id    String      @id @default(uuid()) @db.Uuid
  runId String      @map("run_id") @db.Uuid
  page  Int
  hash  String      @db.VarChar(64)
  items Json
  run   MenuSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, page])
  @@map("menu_sync_pages")
}

model MenuQuarantine {
  id       String      @id @default(uuid()) @db.Uuid
  runId    String      @map("run_id") @db.Uuid
  page     Int
  rowIndex Int         @map("row_index")
  code     String      @db.VarChar(80)
  run      MenuSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, page, rowIndex])
  @@map("menu_quarantine")
}

model OfferSafetyEvidence {
  id         String               @id @default(uuid()) @db.Uuid
  offerId    String               @map("offer_id") @db.Uuid
  kind       SafetyEvidenceKind
  code       String               @db.VarChar(80)
  claim      SafetyEvidenceClaim
  status     SafetyEvidenceStatus @default(PENDING)
  sourceUrl  String               @map("source_url") @db.VarChar(2000)
  excerpt    String               @db.VarChar(2000)
  observedAt DateTime             @map("observed_at") @db.Timestamptz(3)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  offer      ExternalMenuItem     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  reviews    EvidenceReview[]

  @@index([offerId, status, expiresAt])
  @@map("offer_safety_evidence")
}

model EvidenceReview {
  id         String               @id @default(uuid()) @db.Uuid
  evidenceId String               @map("evidence_id") @db.Uuid
  actorId    String?              @map("actor_id") @db.Uuid
  status     SafetyEvidenceStatus
  reason     String               @db.VarChar(1000)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  evidence   OfferSafetyEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([evidenceId, createdAt])
  @@map("evidence_reviews")
}

model AdminAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  targetId  String?  @map("target_id") @db.VarChar(255)
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetId])
  @@map("admin_audit")
}

model DataReport {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  targetKind     String         @map("target_kind") @db.VarChar(10)
  targetSource   String?        @map("target_source") @db.VarChar(30)
  targetId       String         @map("target_id") @db.VarChar(255)
  reason         String         @db.VarChar(30)
  note           String         @db.VarChar(2000)
  status         String         @default("OPEN") @db.VarChar(12)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(255)
  inputHash      String         @map("input_hash") @db.VarChar(64)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviews        ReportReview[]

  @@index([userId, createdAt(sort: Desc), id])
  @@index([status, createdAt, id])
  @@index([targetKind, targetId])
  @@map("data_reports")
}

model ReportReview {
  id         String     @id @default(uuid()) @db.Uuid
  reportId   String     @map("report_id") @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  fromStatus String     @map("from_status") @db.VarChar(12)
  toStatus   String     @map("to_status") @db.VarChar(12)
  reason     String     @db.VarChar(1000)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  report     DataReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_reviews")
}

model MenuSyncSchedule {
  supplierId      String           @id @map("supplier_id") @db.Uuid
  adapterCode     String           @map("adapter_code") @db.VarChar(50)
  enabled         Boolean          @default(false)
  intervalMinutes Int              @map("interval_minutes")
  nextRunAt       DateTime         @map("next_run_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier        MerchantSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  jobs            MenuSyncJob[]

  @@index([enabled, nextRunAt])
  @@map("menu_sync_schedules")
}

model MenuSyncJob {
  id             String           @id @default(uuid()) @db.Uuid
  scheduleId     String           @map("schedule_id") @db.Uuid
  idempotencyKey String           @unique @map("idempotency_key") @db.VarChar(255)
  status         String           @default("QUEUED") @db.VarChar(12)
  attempts       Int              @default(0)
  availableAt    DateTime         @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil     DateTime?        @map("lease_until") @db.Timestamptz(3)
  leaseToken     String?          @map("lease_token") @db.Uuid
  manifest       Json?
  runId          String?          @map("run_id") @db.Uuid
  errorCode      String?          @map("error_code") @db.VarChar(50)
  retryable      Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule       MenuSyncSchedule @relation(fields: [scheduleId], references: [supplierId], onDelete: Restrict)
  run            MenuSyncRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, leaseUntil])
  @@index([scheduleId, status])
  @@index([createdAt, id])
  @@map("menu_sync_jobs")
}
