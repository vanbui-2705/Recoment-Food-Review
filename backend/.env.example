NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://rec_food:change-me@localhost:5432/rec_food?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SEED_ADMIN_EMAIL=admin@rec-food.local
SEED_ADMIN_PASSWORD=change-me-in-local-env
GOOGLE_PLACES_API_KEY=
# All external API credentials are backend-only. Blank keys disable that source.
# Google: https://console.cloud.google.com/google/maps-apis/credentials
# TheMealDB: https://www.themealdb.com/api.php (1 = development only)
THEMEALDB_API_KEY=
# Spoonacular: https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=
# Goong: https://account.goong.io/
GOONG_API_KEY=
# Foursquare: https://docs.foursquare.com/fsq-developers-places/docs/getting-started
FOURSQUARE_API_KEY=
# Geoapify: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Taste analysis: backend-only Gemini GenerateContent structured outputs.
# Set the API key/model available to your project, then start npm run worker separately.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=4096
LLM_DAILY_REQUEST_LIMIT=200
WORKER_ENABLED=false
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=90
